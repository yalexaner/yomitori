# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="file:./data/flashcards.db"

# Google Gemini API (for OCR)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# Google Cloud Text-to-Speech
# Path to your Google Cloud service account credentials JSON file
GOOGLE_APPLICATION_CREDENTIALS=./path/to/gcloud-credentials.json

# Optional: ElevenLabs API (future feature)
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
